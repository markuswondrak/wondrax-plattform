#!/bin/bash
# Usage: ./create_db_user.sh <db_name> <user_name> <password>

DB_NAME=$1
DB_USER=$2
DB_PASS=$3

if [ -z "$DB_NAME" ] || [ -z "$DB_USER" ] || [ -z "$DB_PASS" ]; then
  echo "Usage: $0 <db_name> <db_user> <db_password>"
  exit 1
fi

echo "Ensuring Database $DB_NAME and User $DB_USER exist..."

# 1. Create user (if not exists)
docker exec platform-db-1 psql -U postgres -c "SELECT 1 FROM pg_roles WHERE rolname='$DB_USER'" | grep -q 1 || \
docker exec platform-db-1 psql -U postgres -c "CREATE USER $DB_USER WITH PASSWORD '$DB_PASS';"

# 2. Create database (if not exists)
docker exec platform-db-1 psql -U postgres -c "SELECT 1 FROM pg_database WHERE datname='$DB_NAME'" | grep -q 1 || \
docker exec platform-db-1 psql -U postgres -c "CREATE DATABASE $DB_NAME OWNER $DB_USER;"

# 3. Grant privileges to ensure access
docker exec platform-db-1 psql -U postgres -c "GRANT ALL PRIVILEGES ON DATABASE $DB_NAME TO $DB_USER;"

echo "Done."
